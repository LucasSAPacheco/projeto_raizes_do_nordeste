              "mode": "raw",
              "raw": "{\n  \"pedido_id\": {{pedido_id}}\n}"
            },
            "url": {"raw": "{{base_url}}/fidelidade/ganhar", "host": ["{{base_url}}"], "path": ["fidelidade", "ganhar"]}
