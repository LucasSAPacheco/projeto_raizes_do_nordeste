          }
        }
      ]
    },
    {
      "name": "Plano de Testes",
      "description": "10 cenarios exigidos pelo roteiro: 6 positivos + 4 negativos.",
      "item": [
        {
          "name": "[POS 1] Cadastro de cliente com sucesso",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Teste\",\n  \"email\": \"maria.teste@cliente.com\",\n  \"senha\": \"senha123\",\n  \"perfil\": \"CLIENTE\",\n  \"consentimento_lgpd\": true\n}"
            },
            "url": {"raw": "{{base_url}}/auth/cadastro", "host": ["{{base_url}}"], "path": ["auth", "cadastro"]},
            "description": "Esperado: 201 Created. Cria usuario com perfil CLIENTE e cria saldo de fidelidade zerado."
          }
        },
        {
          "name": "[POS 2] Login retorna JWT",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria.teste@cliente.com\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]},
            "description": "Esperado: 200 OK e access_token no body."
          }
        },
        {
          "name": "[POS 3] Criar unidade (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Unidade Recife Boa Viagem\",\n  \"endereco\": \"Av. Boa Viagem, 1500\",\n  \"cidade\": \"Recife\",\n  \"estado\": \"PE\"\n}"
            },
            "url": {"raw": "{{base_url}}/unidades", "host": ["{{base_url}}"], "path": ["unidades"]},
            "description": "Esperado: 201 Created. Cria nova unidade da rede."
          }
        },
        {
          "name": "[POS 4] Criar pedido (CLIENTE)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_cliente}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": {{unidade_id}},\n  \"canal_pedido\": \"TOTEM\",\n  \"itens\": [\n    { \"produto_id\": {{produto_id}}, \"quantidade\": 1 }\n  ]\n}"
            },
            "url": {"raw": "{{base_url}}/pedidos", "host": ["{{base_url}}"], "path": ["pedidos"]},
            "description": "Esperado: 201 Created. Status inicial AGUARDANDO_PAGAMENTO, estoque descontado."
          }
        },
        {
          "name": "[POS 5] Pagamento aprovado (mock)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_cliente}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedido_id\": {{pedido_id}},\n  \"forma_pagamento\": \"PIX\"\n}"
            },
            "url": {"raw": "{{base_url}}/pagamentos", "host": ["{{base_url}}"], "path": ["pagamentos"]},
            "description": "Esperado: 201 Created. ~90% das vezes retorna APROVADO e o pedido vai para PAGO."
          }
        },
        {
          "name": "[POS 6] Consultar saldo de fidelidade",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_cliente}}"}],
            "url": {"raw": "{{base_url}}/fidelidade/saldo", "host": ["{{base_url}}"], "path": ["fidelidade", "saldo"]},
            "description": "Esperado: 200 OK com saldo do usuario logado."
          }
        },
        {
          "name": "[NEG 1] Cadastro sem consentimento LGPD",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Sem LGPD\",\n  \"email\": \"sem.lgpd@cliente.com\",\n  \"senha\": \"senha123\",\n  \"perfil\": \"CLIENTE\",\n  \"consentimento_lgpd\": false\n}"
            },
            "url": {"raw": "{{base_url}}/auth/cadastro", "host": ["{{base_url}}"], "path": ["auth", "cadastro"]},
            "description": "Esperado: 400 Bad Request. Cadastro recusado por falta de consentimento LGPD."
          }
        },
        {
          "name": "[NEG 2] Login com senha incorreta",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria.teste@cliente.com\",\n  \"senha\": \"senha-errada\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]},
            "description": "Esperado: 401 Unauthorized."
          }
        },
        {
          "name": "[NEG 3] Pedido sem itens",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_cliente}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": {{unidade_id}},\n  \"canal_pedido\": \"APP\",\n  \"itens\": []\n}"
            },
            "url": {"raw": "{{base_url}}/pedidos", "host": ["{{base_url}}"], "path": ["pedidos"]},
            "description": "Esperado: 400 Bad Request. Pedido vazio nao e aceito."
          }
        },
        {
          "name": "[NEG 4] Resgatar pontos sem saldo",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
