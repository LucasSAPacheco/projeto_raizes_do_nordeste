            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"preco\": 13.00\n}"
            },
            "url": {"raw": "{{base_url}}/produtos/{{produto_id}}", "host": ["{{base_url}}"], "path": ["produtos", "{{produto_id}}"]}
          }
        },
        {
          "name": "Remover produto",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/produtos/{{produto_id}}", "host": ["{{base_url}}"], "path": ["produtos", "{{produto_id}}"]}
          }
        }
      ]
    },
    {
      "name": "Estoque",
      "item": [
        {
          "name": "Entrada de estoque",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": {{unidade_id}},\n  \"produto_id\": {{produto_id}},\n  \"tipo\": \"ENTRADA\",\n  \"quantidade\": 50,\n  \"observacao\": \"Reposicao inicial\"\n}"
            },
            "url": {"raw": "{{base_url}}/estoque/movimentar", "host": ["{{base_url}}"], "path": ["estoque", "movimentar"]}
          }
        },
        {
          "name": "Saida de estoque",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": {{unidade_id}},\n  \"produto_id\": {{produto_id}},\n  \"tipo\": \"SAIDA\",\n  \"quantidade\": 2,\n  \"observacao\": \"Ajuste manual\"\n}"
            },
            "url": {"raw": "{{base_url}}/estoque/movimentar", "host": ["{{base_url}}"], "path": ["estoque", "movimentar"]}
          }
        },
        {
          "name": "Listar estoque da unidade",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/estoque/unidades/{{unidade_id}}", "host": ["{{base_url}}"], "path": ["estoque", "unidades", "{{unidade_id}}"]}
          }
        },
        {
          "name": "Saldo de produto na unidade",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/estoque/unidades/{{unidade_id}}/produtos/{{produto_id}}", "host": ["{{base_url}}"], "path": ["estoque", "unidades", "{{unidade_id}}", "produtos", "{{produto_id}}"]}
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido (cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('pedido_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_cliente}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidade_id\": {{unidade_id}},\n  \"canal_pedido\": \"APP\",\n  \"itens\": [\n    { \"produto_id\": {{produto_id}}, \"quantidade\": 2 }\n  ],\n  \"observacao\": \"Sem cebola\"\n}"
            },
            "url": {"raw": "{{base_url}}/pedidos", "host": ["{{base_url}}"], "path": ["pedidos"]}
          }
        },
        {
          "name": "Listar pedidos (admin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {
              "raw": "{{base_url}}/pedidos?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["pedidos"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"}
              ]
            }
          }
        },
        {
          "name": "Meus pedidos (cliente)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_cliente}}"}],
            "url": {"raw": "{{base_url}}/pedidos/meus", "host": ["{{base_url}}"], "path": ["pedidos", "meus"]}
          }
        },
        {
          "name": "Buscar pedido por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_cliente}}"}],
            "url": {"raw": "{{base_url}}/pedidos/{{pedido_id}}", "host": ["{{base_url}}"], "path": ["pedidos", "{{pedido_id}}"]}
          }
        },
        {
          "name": "Atualizar status (PAGO -> EM_PREPARO)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EM_PREPARO\"\n}"
            },
            "url": {"raw": "{{base_url}}/pedidos/{{pedido_id}}/status", "host": ["{{base_url}}"], "path": ["pedidos", "{{pedido_id}}", "status"]}
          }
        }
      ]
    },
