{
  "info": {
    "name": "Raizes do Nordeste API",
    "description": "Colecao de requisicoes para a API Raizes do Nordeste (UNINTER 2026, trilha back-end).\n\nFluxo recomendado:\n1. Cadastre um ADMIN, faca login e o token sera salvo automaticamente em {{token_admin}}.\n2. Cadastre um CLIENTE, faca login e o token sera salvo em {{token_cliente}}.\n3. Crie unidade, produto e movimentacao de estoque (autenticado como admin).\n4. Crie um pedido (autenticado como cliente), pague e ganhe pontos.\n\nA pasta 'Plano de Testes' contem os 10 cenarios exigidos pelo roteiro (6 positivos + 4 negativos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "token_admin", "value": ""},
    {"key": "token_cliente", "value": ""},
    {"key": "unidade_id", "value": ""},
    {"key": "produto_id", "value": ""},
    {"key": "pedido_id", "value": ""}
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"]}
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastrar ADMIN",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Admin Raizes\",\n  \"email\": \"admin@raizes.com\",\n  \"senha\": \"admin123\",\n  \"perfil\": \"ADMIN\",\n  \"consentimento_lgpd\": true\n}"
            },
            "url": {"raw": "{{base_url}}/auth/cadastro", "host": ["{{base_url}}"], "path": ["auth", "cadastro"]}
          }
        },
        {
          "name": "Cadastrar CLIENTE",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Joao da Silva\",\n  \"email\": \"joao@cliente.com\",\n  \"senha\": \"cliente123\",\n  \"perfil\": \"CLIENTE\",\n  \"consentimento_lgpd\": true\n}"
            },
            "url": {"raw": "{{base_url}}/auth/cadastro", "host": ["{{base_url}}"], "path": ["auth", "cadastro"]}
          }
        },
        {
          "name": "Login ADMIN (salva token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_admin', data.access_token);",
                  "  console.log('Token admin salvo.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@raizes.com\",\n  \"senha\": \"admin123\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Login CLIENTE (salva token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_cliente', data.access_token);",
                  "  console.log('Token cliente salvo.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@cliente.com\",\n  \"senha\": \"cliente123\"\n}"
            },
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Meu perfil (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token_cliente}}"}],
            "url": {"raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"]}
          }
        }
      ]
    },
    {
      "name": "Unidades",
      "item": [
        {
          "name": "Criar unidade (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('unidade_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Unidade Centro Fortaleza\",\n  \"endereco\": \"Rua Major Facundo, 100\",\n  \"cidade\": \"Fortaleza\",\n  \"estado\": \"CE\"\n}"
            },
            "url": {"raw": "{{base_url}}/unidades", "host": ["{{base_url}}"], "path": ["unidades"]}
          }
        },
        {
          "name": "Listar unidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/unidades?apenas_ativas=true",
              "host": ["{{base_url}}"],
              "path": ["unidades"],
              "query": [{"key": "apenas_ativas", "value": "true"}]
            }
          }
        },
        {
          "name": "Buscar unidade por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/unidades/{{unidade_id}}", "host": ["{{base_url}}"], "path": ["unidades", "{{unidade_id}}"]}
          }
        },
        {
          "name": "Atualizar unidade",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endereco\": \"Rua Major Facundo, 200\"\n}"
            },
            "url": {"raw": "{{base_url}}/unidades/{{unidade_id}}", "host": ["{{base_url}}"], "path": ["unidades", "{{unidade_id}}"]}
          }
        },
        {
          "name": "Desativar unidade (admin)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token_admin}}"}],
            "url": {"raw": "{{base_url}}/unidades/{{unidade_id}}", "host": ["{{base_url}}"], "path": ["unidades", "{{unidade_id}}"]}
          }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Criar produto (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('produto_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token_admin}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tapioca de queijo coalho\",\n  \"descricao\": \"Recheada com queijo coalho derretido\",\n  \"preco\": 12.50,\n  \"categoria\": \"Lanche\"\n}"
            },
            "url": {"raw": "{{base_url}}/produtos", "host": ["{{base_url}}"], "path": ["produtos"]}
          }
        },
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/produtos", "host": ["{{base_url}}"], "path": ["produtos"]}
          }
        },
        {
          "name": "Buscar produto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{base_url}}/produtos/{{produto_id}}", "host": ["{{base_url}}"], "path": ["produtos", "{{produto_id}}"]}
          }
        },
        {
          "name": "Atualizar produto",
          "request": {
            "method": "PATCH",
            "header": [
